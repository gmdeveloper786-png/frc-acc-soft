# Restricted MySQL QA account for tests/Qa/run-mysql-pest.php and
# tests/Concurrency/run.php. Copy to .env.qa-mysql (gitignored) and fill in.
#
# - Use ONLY the dedicated QA account created by the DBA (see tests/Qa/README.md),
#   never root and never the development database account.
# - Do NOT set DB_DATABASE or DB_URL: each runner targets its own allowlisted
#   database (frc_acct_qa_mysql_test or frc_acct_qa_concurrency_test).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=frc_acct_qa
DB_PASSWORD=
